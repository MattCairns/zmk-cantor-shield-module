#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    behaviors {
        // Layer-tap with fewer misfires during fast typing; tap-then-hold repeats the key.
        lt_thumb: lt_thumb {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&mo>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        terminal {
            bindings = <&kp LG(ENTER)>;
            key-positions = <18 19>;
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
        };

        rofi {
            bindings = <&kp LG(SPACE)>;
            key-positions = <16 17>;
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
        };

        firefox-home {
            bindings = <&kp LG(LS(H))>;
            key-positions = <18 16>;
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
        };

        firefox-work {
            bindings = <&kp LG(LS(W))>;
            key-positions = <2 16>;
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
        };

        asterix {
            bindings = <&kp ASTERISK>;
            key-positions = <4 5>;
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
        };

        num_layer_oneshot {
            bindings = <&sl 2>;
            key-positions = <8 9>;
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <14 15>;
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
        };

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <19 20>;
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
        };
    };

    keymap {

        compatible = "zmk,keymap";

        base {
            // -------------------------------------------------------------------------------
            // | ESC/FN |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  |  \     |
            // | CTRL   |  A  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  ;  | '/CTRL |
            // | SHFT   |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  |  /  |  -     |
            //                     | SYM | SPC/NUM | GUI |   | BSPC | ENT/SYM | ALT |

            bindings = <
&lt 3 ESCAPE &kp Q  &kp W  &kp E  &kp R              &kp T       &kp Y     &kp U              &kp I      &kp O    &kp P          &kp BACKSLASH
&kp LCTRL  &kp A  &kp S  &kp D  &kp F              &kp G       &kp H     &kp J              &kp K      &kp L    &kp SEMICOLON  &mt RCTRL SINGLE_QUOTE
&kp LSHFT  &kp Z  &kp X  &kp C  &kp V              &kp B       &kp N     &kp M              &kp COMMA  &kp DOT  &kp FSLH       &kp MINUS
                         &mo 1  &lt_thumb 2 SPACE  &kp LGUI    &kp BSPC  &lt_thumb 1 ENTER  &kp RALT
            >;

            label = "base";
        };

        symbols {
            // -------------------------------------------------------------------------------
            // |      |  !  |  @  |  {  |  }  |  |  |   | DEL | OUT  | HOME | END | PGUP | BTCLR |
            // |      |  #  |  $  |  (  |  )  |  `  |   | LFT | DWN  |  UP  | RGT | PGDN |  "    |
            // |      |  &  |  ^  |  [  |  ]  |  ~  |   | BT0 | BT1  | BT2  | BT3 | BT4  |       |
            //                    | GUI |     | SPC |   | BSPC |  .  | ALT |

            bindings = <
&none  &kp EXCLAMATION  &kp AT_SIGN  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp PIPE     &kp DELETE     &out OUT_TOG  &kp HOME      &kp END       &kp PG_UP     &bt BT_CLR
&none  &kp HASH         &kp DOLLAR   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp GRAVE    &kp LEFT       &kp DOWN      &kp UP        &kp RIGHT     &kp PG_DN     &kp DOUBLE_QUOTES
&none  &kp AMPERSAND    &kp CARET    &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp TILDE    &bt BT_SEL 0   &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none
                                     &kp LGUI              &trans                 &kp SPACE    &kp BACKSPACE  &kp DOT       &kp RALT
            >;

            label = "sym";
        };

        numbers {
            // -------------------------------------------------------------------------------
            // |      | PREV | G-7 | G-8 | G-9 | NEXT |   |     |  7  |  8  |  9  |  -  |      |
            // |      | PLAY | G-4 | G-5 | G-6 | MUTE |   |     |  4  |  5  |  6  |  =  |      |
            // | SHFT | VOL- | G-1 | G-2 | G-3 | VOL+ |   |     |  1  |  2  |  3  |  0  | SHFT |
            //                     | GUI | SPC  | GUI  |   | BSPC |  .  | ALT |

            bindings = <
&none      &kp C_PREV     &kp LG(NUMBER_7)  &kp LG(NUMBER_8)  &kp LG(NUMBER_9)  &kp C_NEXT    &none     &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp MINUS     &none
&none      &kp C_PP       &kp LG(NUMBER_4)  &kp LG(NUMBER_5)  &kp LG(NUMBER_6)  &kp C_MUTE    &none     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp EQUAL     &none
&kp LSHFT  &kp C_VOL_DN   &kp LG(NUMBER_1)  &kp LG(NUMBER_2)  &kp LG(NUMBER_3)  &kp C_VOL_UP  &none     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_0  &kp RSHFT
                                            &kp LGUI          &kp SPACE         &kp LGUI      &kp BSPC  &kp DOT       &kp RALT
            >;

            label = "num";
        };

        functions {
            // -------------------------------------------------------------------------------
            // |      |     |     |     |     |     |   |     | F9  | F10 | F11 | F12 |      |
            // |      |     |     |     |     |     |   |     | F5  | F6  | F7  | F8  |      |
            // | BOOT |     |     |     |     |     |   |     | F1  | F2  | F3  | F4  | BOOT |
            //                    |     |     |     |   |     |     |     |

            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp F9  &kp F10  &kp F11  &kp F12  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp F5  &kp F6   &kp F7   &kp F8   &trans
&bootloader  &trans  &trans  &trans  &trans  &trans    &trans  &kp F1  &kp F2   &kp F3   &kp F4   &bootloader
                             &trans  &trans  &trans    &trans  &trans  &trans
            >;

            label = "fn";
        };
    };
};
